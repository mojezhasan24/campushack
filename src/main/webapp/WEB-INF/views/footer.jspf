<%@ page contentType="text/html;charset=UTF-8" language="java" %>
<%@ taglib prefix="c" uri="jakarta.tags.core" %>

<footer class="footer">
    <div class="footer-container">
        <a href="<c:url value='/'/>" class="brand-logo" style="font-size: 1.3rem;">
            <span class="material-symbols-outlined icon-filled animate-wiggle" style="font-size: 24px;">code_blocks</span>
            CAMPUSHACK ⚡
        </a>
        <div class="label-sm text-muted" style="font-weight: 700; color: rgba(255,255,255,0.7);">
            © 2026 CampusHack Management System 🔥 Built for collegiate innovators.
        </div>
        <div style="display: flex; gap: 20px; align-items: center;">
            <a href="#" class="label-sm" style="color: var(--secondary); text-decoration: none;" onmouseover="this.style.color='var(--tertiary)'" onmouseout="this.style.color='var(--secondary)'">Privacy Policy</a>
            <span style="color: var(--accent);">•</span>
            <a href="#" class="label-sm" style="color: var(--secondary); text-decoration: none;" onmouseover="this.style.color='var(--tertiary)'" onmouseout="this.style.color='var(--secondary)'">Terms of Service</a>
            <span style="color: var(--accent);">•</span>
            <a href="#" class="label-sm" style="color: var(--secondary); text-decoration: none;" onmouseover="this.style.color='var(--tertiary)'" onmouseout="this.style.color='var(--secondary)'">Contact Support 💬</a>
        </div>
    </div>
</footer>
