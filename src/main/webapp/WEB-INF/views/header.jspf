<%@ page contentType="text/html;charset=UTF-8" language="java" %>
<%@ taglib prefix="c" uri="jakarta.tags.core" %>

<nav class="navbar">
    <div class="nav-container">
        <!-- Brand Logo — always links to root which redirects appropriately -->
        <a href="<c:url value='/'/>" class="brand-logo">
            <span class="material-symbols-outlined icon-filled animate-wiggle" style="font-size: 28px;">code_blocks</span>
            CAMPUSHACK <span style="font-family: var(--font-body); font-size: 18px;">⚡</span>
        </a>

        <!-- Navigation Links — only shown to logged-in users -->
        <div class="nav-links">
            <c:if test="${not empty sessionScope.user}">
                <%-- Participant and common links --%>
                <c:if test="${sessionScope.role == 'PARTICIPANT'}">
                    <a href="<c:url value='/dashboard'/>"
                       class="nav-link ${pageContext.request.servletPath.contains('dashboard') ? 'active' : ''}">⚡ Dashboard</a>
                    <a href="<c:url value='/discover'/>"
                       class="nav-link ${pageContext.request.servletPath.contains('discover') || pageContext.request.servletPath.contains('discovery') ? 'active' : ''}">🚀 Discover</a>
                    <a href="<c:url value='/recruitment/browse'/>"
                       class="nav-link ${pageContext.request.servletPath.contains('recruitment') ? 'active' : ''}">🤝 Find a Team</a>
                </c:if>

                <%-- Admin links --%>
                <c:if test="${sessionScope.role == 'ADMIN'}">
                    <a href="<c:url value='/admin/dashboard'/>"
                       class="nav-link ${pageContext.request.servletPath.contains('admin_analytics') ? 'active' : ''}">📊 Analytics</a>
                    <a href="<c:url value='/admin/hackathons'/>"
                       class="nav-link ${pageContext.request.servletPath.contains('admin_hackathons') ? 'active' : ''}">🏆 Manage Events</a>
                    <a href="<c:url value='/admin/users'/>"
                       class="nav-link ${pageContext.request.servletPath.contains('admin_users') ? 'active' : ''}">👥 User Mgmt</a>
                    <a href="<c:url value='/discover'/>"
                       class="nav-link ${pageContext.request.servletPath.contains('discover') || pageContext.request.servletPath.contains('discovery') ? 'active' : ''}">🚀 Discover</a>
                </c:if>

                <%-- Judge links --%>
                <c:if test="${sessionScope.role == 'JUDGE'}">
                    <a href="<c:url value='/judge/eval'/>"
                       class="nav-link ${pageContext.request.servletPath.contains('judge_eval') ? 'active' : ''}">⚖️ Evaluation Portal</a>
                </c:if>
            </c:if>
        </div>

        <!-- Trailing User Actions -->
        <div style="display: flex; align-items: center; gap: 12px; flex-shrink: 0;">
            <c:choose>
                <c:when test="${not empty sessionScope.user}">
                    <c:if test="${sessionScope.role == 'ADMIN'}">
                        <button type="button" id="adminThemeToggleBtn" onclick="toggleAdminTheme()" class="btn btn-outline" style="padding: 6px 12px; font-size: 11px; border-width: 2px;" title="Switch Theme (Professional Minimalist vs Dopamine)">
                            <span id="adminThemeToggleIcon" class="material-symbols-outlined" style="font-size: 15px;">style</span>
                            <span id="adminThemeToggleText">PRO MODE 👔</span>
                        </button>
                    </c:if>
                    <a href="<c:url value='/notifications'/>" class="chip chip-secondary" style="padding: 6px 10px; font-size: 14px; text-decoration: none;" title="Notifications">
                        🔔
                    </a>
                    <div style="display: flex; align-items: center; gap: 8px;">
                        <span class="chip chip-tertiary" style="font-size: 10px; text-transform: uppercase; border-width: 2px;">${sessionScope.role}</span>
                        <span class="label-sm" style="color: var(--fg); max-width: 140px; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; font-weight: 800;">${sessionScope.user.fullName}</span>
                    </div>
                    <button onclick="handleLogout()" class="btn btn-outline" style="padding: 6px 14px; font-size: 12px; border-width: 3px;">
                        <span class="material-symbols-outlined" style="font-size: 16px;">logout</span>
                        Logout
                    </button>
                </c:when>
                <c:otherwise>
                    <c:choose>
                        <c:when test="${pageContext.request.servletPath.contains('register')}">
                            <a href="<c:url value='/login'/>" class="btn btn-outline" style="padding: 8px 18px; font-size: 12px;">Log In 🚀</a>
                            <a href="<c:url value='/register'/>" class="btn btn-primary" style="padding: 8px 20px; font-size: 12px;">Register ✨</a>
                        </c:when>
                        <c:otherwise>
                            <a href="<c:url value='/register'/>" class="btn btn-outline" style="padding: 8px 18px; font-size: 12px;">Register ✨</a>
                            <a href="<c:url value='/login'/>" class="btn btn-primary" style="padding: 8px 20px; font-size: 12px;">Log In 🚀</a>
                        </c:otherwise>
                    </c:choose>
                </c:otherwise>
            </c:choose>
        </div>
    </div>
</nav>

<script>
async function handleLogout() {
    await fetch('<c:url value="/api/auth/logout"/>', { method: 'POST' });
    window.location.href = '<c:url value="/login"/>';
}
</script>
